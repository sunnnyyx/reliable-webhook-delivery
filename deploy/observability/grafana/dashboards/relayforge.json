{
  "uid": "relayforge-operations",
  "title": "RelayForge operations",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "relayforge"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Acceptance requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "relayforge-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(relayforge_events_total[5m]))",
          "legendFormat": "{{result}}{{status}}{{outcome}}{{reason}}{{dependency}}{{role}}{{status_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Acceptance p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "relayforge-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(relayforge_acceptance_duration_seconds_bucket[5m])))",
          "legendFormat": "{{result}}{{status}}{{outcome}}{{reason}}{{dependency}}{{role}}{{status_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
