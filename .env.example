# Local development only. Replace both matching password values before use.
PROFILE=development
POSTGRES_HOST_PORT=5432
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgres://relayforge:replace-with-local-password@127.0.0.1:5432/relayforge_dev?sslmode=disable
API_ADDR=:8080
WORKER_ADDR=127.0.0.1:8081
DB_MAX_CONNS=10
WORKER_CONCURRENCY=8
QUEUE_POLL_INTERVAL=500ms
STARTUP_TIMEOUT=5s
READY_TIMEOUT=1s
SHUTDOWN_TIMEOUT=15s
# Required for API and worker. Generate once, preserve securely, never change casually.
# python3 -c 'import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())'
ENCRYPTION_KEY=
# Only development may opt into this exact local receiver URL; blank by default.
DEV_RECEIVER_URL=
OUTBOUND_TIMEOUT=10s
DELIVERY_LEASE=30s
RECEIVER_ADDR=127.0.0.1:8090
# Set to a one-time endpoint signing secret (or two comma-separated keys).
RECEIVER_SECRETS=

# Receiver-owned database/schema, migrated separately; never defaults to sender storage.
# Use a dedicated local DB such as relayforge_receiver_dev with the matching local credentials.
RECEIVER_DATABASE_URL=
# Stable trusted namespace for ONE sender tenant/source and its accepted signing keys.
RECEIVER_SOURCE=relayforge-demo

# Optional distributed admission. All worker replicas must use identical values.
RATE_LIMIT_ENABLED=false
REDIS_HOST_PORT=16379
REDIS_URL=redis://127.0.0.1:16379/0
RATE_LIMIT_PREFIX=relayforge-v1
TENANT_RATE_PER_SECOND=10
TENANT_BURST=20
# Enforced in PostgreSQL even when Redis admission is disabled.
MAX_TENANT_IN_FLIGHT=4
MAX_TENANT_BACKLOG=10000

# Operational listeners always bind a literal loopback address. Public API has no /metrics.
API_OPS_ADDR=127.0.0.1:9091
# Optional explicit OTLP/HTTP traces URL; blank disables traces, not metrics.
# Local observability profile: http://127.0.0.1:14318/v1/traces
TRACE_ENDPOINT=
TRACE_SAMPLE_RATIO=0.1
# Local-only Grafana defaults to admin / relayforge-local-only when blank.
GRAFANA_ADMIN_PASSWORD=

# Optional local product interface (development only; literal loopback addresses).
CONSOLE_ADDR=127.0.0.1:8091
CONSOLE_API_URL=http://127.0.0.1:8080

# Set CONSOLE_AUTH=github to test GitHub login locally after configuring Supabase.
CONSOLE_AUTH=api-key
# Public deployment only. Keep PROFILE=development for local development.
# HTTPS origin without trailing slash, e.g. https://your-service.onrender.com
PUBLIC_URL=
SUPABASE_URL=
# Supabase publishable key (sb_publishable_...). Never supply a service-role key.
SUPABASE_PUBLISHABLE_KEY=
# PORT is supplied automatically by the hosting platform.
